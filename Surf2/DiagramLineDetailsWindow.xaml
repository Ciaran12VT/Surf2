<Window x:Class="Surf2.DiagramLineDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line Details"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="Line color" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Width="72"
                        Height="28"
                        Click="LineColorButton_Click"
                        ToolTip="Choose line color">
                    <Grid Width="44"
                          Height="16">
                        <Rectangle x:Name="LineColorSwatch"
                                   Fill="#000000"
                                   Stroke="#9CA3AF"
                                   StrokeThickness="1" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="HasEndArrowCheckBox"
                  Grid.Row="1"
                  Margin="90,12,0,0"
                  Content="Arrow at end" />

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Height="28"
                    Style="{StaticResource SurfSaveButtonStyle}"
                    Content="Save"
                    Click="SaveButton_Click" />
            <Button Width="88"
                    Height="28"
                    Margin="8,0,0,0"
                    Style="{StaticResource SurfCloseButtonStyle}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
