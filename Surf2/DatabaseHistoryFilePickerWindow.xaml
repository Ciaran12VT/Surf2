<Window x:Class="Surf2.DatabaseHistoryFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select File"
        Width="860"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top"
              Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,8,6"
                       VerticalAlignment="Center"
                       Text="Database" />
            <ComboBox x:Name="DatabaseComboBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,0,0,6"
                      Height="28"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="DatabaseComboBox_SelectionChanged" />

            <TextBlock Grid.Row="0"
                       Grid.Column="3"
                       Margin="0,0,8,6"
                       VerticalAlignment="Center"
                       Text="Version" />
            <ComboBox x:Name="VersionComboBox"
                      Grid.Row="0"
                      Grid.Column="4"
                      Margin="0,0,0,6"
                      Height="28"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="VersionComboBox_SelectionChanged" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Find" />
            <TextBox x:Name="FilterTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="4"
                     Height="28"
                     VerticalContentAlignment="Center"
                     TextChanged="FilterTextBox_TextChanged" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom"
                   Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#4B5563" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button x:Name="PickButton"
                        Width="86"
                        Margin="0,0,8,0"
                        Click="PickButton_Click"
                        Content="Select"
                        IsEnabled="False"
                        Style="{StaticResource SurfSaveButtonStyle}" />
                <Button Width="86"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        Style="{StaticResource SurfCloseButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <ListView x:Name="FilesListView"
                  MouseDoubleClick="FilesListView_MouseDoubleClick"
                  SelectionChanged="FilesListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Resource Type"
                                    Width="170"
                                    DisplayMemberBinding="{Binding ResourceTypeDisplay}" />
                    <GridViewColumn Header="Name"
                                    Width="610"
                                    DisplayMemberBinding="{Binding FileNameDisplay}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
