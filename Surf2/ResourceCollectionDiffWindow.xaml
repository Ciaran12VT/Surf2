<Window x:Class="Surf2.ResourceCollectionDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Surf2.Models"
        Title="Resource Collection Diff"
        Width="1120"
        Height="720"
        MinWidth="820"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CollectionToggleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#1E3A8A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftHeaderText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           x:Name="RightHeaderText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="IgnoreWhitespaceCheckBox"
                          VerticalAlignment="Center"
                          Checked="IgnoreWhitespaceCheckBox_CheckedChanged"
                          Content="Ignore whitespace"
                          Foreground="#1F2937"
                          Unchecked="IgnoreWhitespaceCheckBox_CheckedChanged" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           Text="Find:" />
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="3"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged" />
            </Grid>
        </Grid>

        <ListView x:Name="RowsListView"
                  Grid.Row="1"
                  MouseDoubleClick="RowsListView_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="CompareWithMenuItem_Click"
                              Header="Compare with..." />
                    <Separator />
                    <MenuItem Click="ExcludeMenuItem_Click"
                              Header="Exclude" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <EventSetter Event="PreviewMouseRightButtonDown"
                                 Handler="Row_PreviewMouseRightButtonDown" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="500" Header="Left">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ResourceCollectionDiffRow}">
                                <Border MinHeight="26"
                                        Padding="8,3"
                                        Background="{Binding LeftBackground}">
                                    <DockPanel Margin="{Binding IndentMargin}"
                                               LastChildFill="True">
                                        <Button Click="ToggleRowButton_Click"
                                                Content="{Binding ToggleGlyph}"
                                                Style="{StaticResource CollectionToggleButtonStyle}"
                                                ToolTip="{Binding ToggleToolTip}"
                                                Visibility="{Binding LeftToggleVisibility}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding LeftName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="108" Header="Status">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ResourceCollectionDiffRow}">
                                <TextBlock Padding="8,4"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StatusForeground}"
                                           Text="{Binding DisplayStatus}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="500" Header="Right">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ResourceCollectionDiffRow}">
                                <Border MinHeight="26"
                                        Padding="8,3"
                                        Background="{Binding RightBackground}">
                                    <DockPanel Margin="{Binding IndentMargin}"
                                               LastChildFill="True">
                                        <Button Click="ToggleRowButton_Click"
                                                Content="{Binding ToggleGlyph}"
                                                Style="{StaticResource CollectionToggleButtonStyle}"
                                                ToolTip="{Binding ToggleToolTip}"
                                                Visibility="{Binding RightToggleVisibility}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding RightName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#64748B" />
    </Grid>
</Window>
