                                                      Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"
                                                               Text="Link:" />
                                                    <TextBox x:Name="MetadataLinkTextBox"
                                                             Grid.Column="1"
                                                             Height="24"
                                                             Margin="8,0"
                                                             VerticalContentAlignment="Center" />
                                                    <Button x:Name="MetadataPickResourceButton"
                                                            Grid.Column="2"
                                                            Width="102"
                                                            Height="24"
                                                            Margin="0,0,8,0"
                                                            Background="#2563EB"
                                                            Style="{StaticResource RoundedToolbarButtonStyle}"
                                                            Click="MetadataPickResourceButton_Click"
                                                            Content="Pick Resource" />
                                                    <Button x:Name="MetadataOpenLinkButton"
                                                            Grid.Column="3"
                                                            Width="56"
                                                            Height="24"
                                                            Background="#2563EB"
                                                            Style="{StaticResource RoundedToolbarButtonStyle}"
                                                            Click="MetadataOpenLinkButton_Click"
                                                            Content="Open" />
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Margin="0,0,0,4"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           Text="Documentation:" />

                                                <WrapPanel Grid.Row="2"
                                                           Margin="0,0,0,6">
                                                    <ToggleButton x:Name="MetadataBoldButton"
                                                                  Width="28"
                                                                  Height="24"
                                                                  FontWeight="Bold"
                                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                                  Click="MetadataBoldButton_Click"
                                                                  Content="B"
                                                                  ToolTip="Bold" />
                                                    <ToggleButton x:Name="MetadataItalicButton"
                                                                  Width="28"
                                                                  Height="24"
                                                                  Margin="4,0,0,0"
                                                                  FontStyle="Italic"
                                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                                  Click="MetadataItalicButton_Click"
                                                                  Content="I"
                                                                  ToolTip="Italic" />
                                                    <ToggleButton x:Name="MetadataUnderlineButton"
                                                                  Width="28"
                                                                  Height="24"
                                                                  Margin="4,0,0,0"
                                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                                  Click="MetadataUnderlineButton_Click"
                                                                  Content="U"
                                                                  ToolTip="Underline" />
                                                    <ToggleButton x:Name="MetadataStrikethroughButton"
                                                                  Width="28"
                                                                  Height="24"
                                                                  Margin="4,0,8,0"
                                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                                  Click="MetadataStrikethroughButton_Click"
                                                                  Content="S"
                                                                  ToolTip="Strikethrough" />
                                                    <ComboBox x:Name="MetadataFontFamilyComboBox"
                                                              Width="118"
                                                              Height="24"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="MetadataFontFamilyComboBox_SelectionChanged"
                                                              ToolTip="Font family" />
                                                    <ComboBox x:Name="MetadataFontSizeComboBox"
                                                              Width="56"
                                                              Height="24"
                                                              Margin="0,0,6,0"
                                                              SelectionChanged="MetadataFontSizeComboBox_SelectionChanged"
                                                              ToolTip="Font size">
                                                        <ComboBoxItem Content="10" />
                                                        <ComboBoxItem Content="11" />
                                                        <ComboBoxItem Content="12" IsSelected="True" />
                                                        <ComboBoxItem Content="14" />
                                                        <ComboBoxItem Content="16" />
                                                        <ComboBoxItem Content="18" />
                                                        <ComboBoxItem Content="20" />
                                                        <ComboBoxItem Content="24" />
                                                        <ComboBoxItem Content="28" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="MetadataHeaderComboBox"
                                                              Width="92"
                                                              Height="24"
                                                              SelectionChanged="MetadataHeaderComboBox_SelectionChanged"
                                                              ToolTip="Section header">
                                                        <ComboBoxItem Content="Normal" IsSelected="True" />
                                                        <ComboBoxItem Content="Header 1" />
                                                        <ComboBoxItem Content="Header 2" />
                                                        <ComboBoxItem Content="Header 3" />
                                                    </ComboBox>
                                                </WrapPanel>

                                                <RichTextBox x:Name="MetadataDocumentationRichTextBox"
                                                             Grid.Row="3"
                                                             AcceptsTab="True"
                                                             BorderBrush="#CBD5E1"
                                                             BorderThickness="1"
                                                             SelectionChanged="MetadataDocumentationRichTextBox_SelectionChanged"
                                                             VerticalScrollBarVisibility="Auto">
                                                    <FlowDocument />
                                                </RichTextBox>

                                                <GridSplitter Grid.Row="4"
                                                              Height="5"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              Background="#D7DCE2"
                                                              ResizeBehavior="PreviousAndNext"
                                                              ResizeDirection="Rows" />

                                                <Grid Grid.Row="5"
                                                      Margin="0,8,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0"
                                                               Margin="0,0,0,6">
                                                        <Button x:Name="AddMetadataQueryButton"
                                                                DockPanel.Dock="Right"
                                                                Width="28"
                                                                Height="24"
                                                                Background="#2563EB"
                                                                Style="{StaticResource RoundedToolbarButtonStyle}"
                                                                Click="AddMetadataQueryButton_Click"
                                                                Content="+"
                                                                ToolTip="Add query" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"
                                                                   Text="Queries:" />
                                                    </DockPanel>
                                                    <ScrollViewer Grid.Row="1"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <StackPanel x:Name="MetadataQueriesPanel" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>

                                            <Border x:Name="MetadataEditorPlaceholder"
                                                    Background="#FFFFFF">
                                                <TextBlock x:Name="MetadataEditorPlaceholderText"
                                                           Margin="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#64748B"
                                                           Text="Select a diagram object to edit metadata."
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Workflows">
                                        <Grid Margin="10">
                                            <Grid x:Name="WorkflowListPanel">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Button x:Name="NewWorkflowButton"
                                                        Grid.Row="0"
                                                        Height="30"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#2563EB"
                                                        Style="{StaticResource RoundedToolbarButtonStyle}"
                                                        Click="NewWorkflowButton_Click"
                                                        Content="New Workflow" />
                                                <ScrollViewer Grid.Row="1"
                                                              Margin="0,10,0,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <StackPanel x:Name="WorkflowListItemsPanel" />
                                                        <TextBlock x:Name="WorkflowListPlaceholder"
                                                                   Margin="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#64748B"
                                                                   Text="No workflows for this diagram yet."
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center" />
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>

                                            <Grid x:Name="WorkflowDetailsPanel"
                                                  Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Button x:Name="WorkflowBackButton"
                                                        Grid.Row="0"
                                                        Height="30"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#111827"
                                                        Style="{StaticResource RoundedToolbarButtonStyle}"
                                                        Click="WorkflowBackButton_Click"
                                                        Content="Back" />

                                                <Grid Grid.Row="1"
                                                      Margin="0,10,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"
                                                               Text="Workflow Name:" />
                                                    <TextBox x:Name="WorkflowNameTextBox"
                                                             Grid.Column="1"
                                                             Height="24"
                                                             Margin="8,0,0,0"
                                                             VerticalContentAlignment="Center" />
                                                </Grid>

                                                <ToggleButton x:Name="WorkflowAddItemsToggleButton"
                                                              Grid.Row="2"
                                                              Height="30"
                                                              HorizontalAlignment="Stretch"
                                                              Style="{StaticResource WorkflowSidebarToggleStyle}"
                                                              Click="WorkflowAddItemsToggleButton_Click"
                                                              Content="Add Items: OFF" />

                                                <ScrollViewer x:Name="WorkflowItemsScrollViewer"
                                                              Grid.Row="3"
                                                              Margin="0,10,0,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <StackPanel x:Name="WorkflowItemsPanel" />
                                                        <TextBlock x:Name="WorkflowItemsPlaceholder"
                                                                   Margin="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#64748B"
                                                                   Text="No workflow items yet."
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center" />
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Row="2"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0"
                                        Background="#F8FAFC">
                                    <Button x:Name="DiagramSidebarSaveButton"
                                            Width="88"
                                            Height="28"
                                            Margin="0,8,12,8"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource GreenToolbarButtonStyle}"
                                            Click="DiagramSidebarSaveButton_Click"
                                            Content="Save" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Background="#FFFFFF">
            <TextBlock Margin="10,0"
                       VerticalAlignment="Center"
                       Foreground="#4B5563"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
