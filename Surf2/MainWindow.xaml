<Window x:Class="Surf2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:models="clr-namespace:Surf2.Models"
        mc:Ignorable="d"
        Title="Surf 2.0"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="600"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Closing="Window_Closing"
        Icon="Assets/surf2_icon.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="RoundedToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#16A34A" />
        </Style>

        <Style x:Key="RedToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="BlueToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E3A8A" />
        </Style>

        <Style x:Key="TinyCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <TextBlock Margin="0,-1,0,0"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       LineHeight="10"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="{TemplateBinding Content}"
                                       TextAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#7F1D1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerTabPinToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonChromeHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewHeaderIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonChromeHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonChromePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#93C5FD" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonChromeBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ButtonChromePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegexToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#A0A7B0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewModeToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagramToolToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonCheckedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonCheckedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagramToolButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonCheckedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonCheckedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowSidebarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Theme.ToolButtonCheckedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Theme.ToolButtonCheckedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitOrientationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemNode}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True"
                       MinHeight="22"
                       ToolTip="{Binding ToolTip}">
                <Viewbox Width="16"
                         Height="16"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center">
                    <Path Data="{Binding IconGeometry}"
                          Fill="Transparent"
                          Stroke="{Binding IconBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.7"
                          Stretch="Uniform" />
                </Viewbox>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding TextBrush}"
                           Text="{Binding Name}" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource Theme.SurfaceBrush}">
            <DockPanel Margin="10,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="WorkbenchSelector"
                              Width="240"
                              Height="30"
                              Margin="0,0,8,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding SavedWorkbenches}"
                              SelectionChanged="WorkbenchSelector_SelectionChanged"
                              ToolTip="Load saved Workbench" />
                    <Button Width="138"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource GreenToolbarButtonStyle}"
                            Click="SaveWorkbenchButton_Click"
                            Content="Save Workbench" />
                    <Button Width="82"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource BlueToolbarButtonStyle}"
                            Click="SaveWorkbenchAsButton_Click"
                            Content="Save As" />
                    <Button x:Name="DeleteWorkbenchButton"
                            Width="76"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource RedToolbarButtonStyle}"
                            Click="DeleteWorkbenchButton_Click"
                            Content="Delete"
                            IsEnabled="False" />
                    <Button Style="{StaticResource SettingsCogButtonStyle}"
                            Click="SettingsButton_Click"
                            Content="&#xE713;"
                            ToolTip="Settings" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="116"
                            Height="30"
                            Style="{StaticResource GreenToolbarButtonStyle}"
                            Click="ScopesButton_Click"
                            Content="Scopes" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource CircleToolbarButtonStyle}"
                            Click="BackButton_Click"
                            Content="&#x2190;"
                            IsEnabled="{Binding CanNavigateBack}"
                            ToolTip="Back" />
                    <Button Margin="4,0,0,0"
                            Style="{StaticResource CircleToolbarButtonStyle}"
                            Click="ForwardButton_Click"
                            Content="&#x2192;"
                            IsEnabled="{Binding CanNavigateForward}"
                            ToolTip="Forward" />
                    <Button Width="108"
                            Height="30"
                            Margin="8,0,0,0"
                            Style="{StaticResource RedToolbarButtonStyle}"
                            Click="CloseAllButton_Click"
                            Content="Close All" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ToggleButton x:Name="CodeViewToggle"
                                  Style="{StaticResource ViewModeToggleStyle}"
                                  Checked="ViewToggle_CheckedChanged"
                                  Content="Code"
                                  IsChecked="True"
                                  MouseDoubleClick="ViewToggle_MouseDoubleClick"
                                  Unchecked="ViewToggle_CheckedChanged" />
                    <ToggleButton x:Name="DiagramViewToggle"
                                  Margin="12,0,0,0"
                                  Style="{StaticResource ViewModeToggleStyle}"
                                  Checked="ViewToggle_CheckedChanged"
                                  Content="Diagram"
                                  MouseDoubleClick="ViewToggle_MouseDoubleClick"
                                  Unchecked="ViewToggle_CheckedChanged" />
                    <Button x:Name="SplitOrientationButton"
                            Margin="10,0,0,0"
                            Style="{StaticResource SplitOrientationButtonStyle}"
                            Click="SplitOrientationButton_Click"
                            ToolTip="Enable Code and Diagram to change split orientation">
                        <Grid x:Name="SplitOrientationIcon"
                              Width="32"
                              Height="32"
                              IsHitTestVisible="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SplitOrientationIconRotation" Angle="270" />
                            </Grid.RenderTransform>
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="16,16"
                                                     RadiusX="15"
                                                     RadiusY="15" />
                                </Grid.Clip>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Theme.SurfaceBrush}" />
                                <Border Grid.Column="1"
                                        Background="#374151" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource Theme.InactiveCanvasBrush}" />
                            </Grid>
                            <Ellipse Fill="Transparent"
                                     Stroke="{DynamicResource Theme.MutedTextBrush}"
                                     StrokeThickness="1" />
                        </Grid>
                    </Button>
                </StackPanel>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                           Text="{Binding CurrentFolderDisplay}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource Theme.SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextBrush}"
                                   Text="Object Explorer" />
                    </Border>
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Find:" />
                            <TextBox x:Name="ObjectExplorerSearchTextBox"
                                     Grid.Column="1"
                                     AllowDrop="True"
                                     FontSize="12"
                                     Height="24"
                                     Margin="6,0,6,0"
                                     VerticalContentAlignment="Center"
                                     DataObject.Pasting="ObjectExplorerSearchTextBox_Pasting"
                                     KeyDown="ObjectExplorerSearchTextBox_KeyDown"
                                     PreviewDragOver="ObjectExplorerSearchTextBox_PreviewDragOver"
                                     PreviewKeyDown="ObjectExplorerSearchTextBox_PreviewKeyDown"
                                     PreviewDrop="ObjectExplorerSearchTextBox_PreviewDrop" />
                            <ToggleButton x:Name="ObjectExplorerRegexToggle"
                                          Grid.Column="2"
                                          Width="38"
                                          Height="24"
                                          Style="{StaticResource RegexToggleStyle}"
                                          Content="(.*)" />
                            <TextBlock Grid.Column="3"
                                       Margin="8,0,5,0"
                                       VerticalAlignment="Center"
                                       Text="in" />
                            <ComboBox x:Name="ObjectExplorerSearchTargetComboBox"
                                      Grid.Column="4"
                                      Width="82"
                                      Height="24"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Name" />
                                <ComboBoxItem Content="Content" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <TreeView x:Name="ObjectExplorer"
                                  AllowDrop="True"
                                  BorderThickness="0"
                                  ContextMenuOpening="ObjectExplorer_ContextMenuOpening"
                                  Drop="ObjectExplorer_Drop"
                                  DragOver="ObjectExplorer_DragOver"
                                  ItemsSource="{Binding RootNodes}"
                                  MouseDoubleClick="ObjectExplorer_MouseDoubleClick"
                                  MouseMove="ObjectExplorer_MouseMove"
                                  PreviewMouseLeftButtonDown="ObjectExplorer_PreviewMouseLeftButtonDown"
                                  TreeViewItem.PreviewMouseDoubleClick="ObjectExplorerItem_PreviewMouseDoubleClick"
                                  TreeViewItem.PreviewMouseRightButtonDown="ObjectExplorerItem_PreviewMouseRightButtonDown"
                                  TreeViewItem.Collapsed="ObjectExplorerItem_Collapsed"
                                  TreeViewItem.Expanded="ObjectExplorerItem_Expanded">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <Grid x:Name="ObjectExplorerLoadingOverlay"
                              Background="{DynamicResource Theme.OverlayBrush}"
                              Visibility="Collapsed">
                            <Border MinWidth="190"
                                    MaxWidth="280"
                                    Padding="16,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Theme.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Theme.StrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="34"
                                          Height="34"
                                          HorizontalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform />
                                        </Grid.RenderTransform>
                                        <Ellipse Width="30"
                                                 Height="30"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Stroke="{DynamicResource Theme.BorderBrush}"
                                                 StrokeThickness="4" />
                                        <Path Data="M17,2 A15,15 0 0 1 32,17"
                                              Stroke="{DynamicResource Theme.AccentBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="4" />
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:0.85"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                    <TextBlock x:Name="ObjectExplorerLoadingText"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.TextBrush}"
                                               Text="Loading resources..." />
                                    <TextBlock x:Name="ObjectExplorerLoadingDetailText"
                                               MaxWidth="240"
                                               MaxHeight="48"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource Theme.BorderBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" />
                    <TabControl x:Name="ExplorerDetailTabs"
                                Grid.Row="4"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="0,1,0,0">
                        <TabItem x:Name="OpenWindowsTabItem">
                            <TabItem.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Open Windows" />
                                    <ToggleButton x:Name="OpenWindowsTabPinButton"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Click="ExplorerDetailTabPinButton_Click"
                                                  Content="&#xE718;"
                                                  Style="{StaticResource ExplorerTabPinToggleStyle}"
                                                  ToolTip="Pin Open Windows" />
                                </DockPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Background="{DynamicResource Theme.SurfaceAltBrush}"
                                        Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                                   Text="Name" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                                   Text="Type" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="OpenTabsList"
                                         Grid.Row="1"
                                         BorderThickness="0"
                                         ItemsSource="{Binding OpenTabs}"
                                         MouseMove="OpenTabsList_MouseMove"
                                         PreviewMouseLeftButtonDown="OpenTabsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="OpenTabsList_PreviewMouseLeftButtonUp"
                                         ContextMenuOpening="OpenTabsList_ContextMenuOpening"
                                         SelectionChanged="OpenTabsList_SelectionChanged">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="CloseOpenTabMenuItem_Click"
                                                      Header="Close" />
                                            <MenuItem Click="CloseAllButThisOpenTabMenuItem_Click"
                                                      Header="Close all but this" />
                                            <Separator />
                                            <MenuItem Click="CloseAllOpenTabsMenuItem_Click"
                                                      Header="Close all" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}"
                                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch" />
                                            <Setter Property="Padding"
                                                    Value="0" />
                                            <EventSetter Event="PreviewMouseRightButtonDown"
                                                         Handler="OpenTabsListItem_PreviewMouseRightButtonDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:OpenWindowItem}">
                                            <Grid MinHeight="26"
                                                  Background="{Binding TypeBackBrush}"
                                                  ToolTip="{Binding ToolTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Margin="8,0,4,0"
                                                           Foreground="Black"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,8,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="Black"
                                                           Text="{Binding Type}"
                                                           TextAlignment="Left" />
                                                <Button Grid.Column="2"
                                                        Margin="2,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Click="OpenTabCloseButton_Click"
                                                        Content="x"
                                                        Style="{StaticResource TinyCloseButtonStyle}"
                                                        ToolTip="Close" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="PreviewTabItem">
                            <TabItem.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Preview" />
                                    <ToggleButton x:Name="PreviewTabPinButton"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Click="ExplorerDetailTabPinButton_Click"
                                                  Content="&#xE718;"
                                                  Style="{StaticResource ExplorerTabPinToggleStyle}"
                                                  ToolTip="Pin Preview" />
                                </DockPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Background="{DynamicResource Theme.SurfaceAltBrush}"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewHeaderText"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.TextBrush}"
                                                   Text="No reference selected"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="PreviewPopOutButton"
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Click="PreviewPopOutButton_Click"
                                                Content="&#xE8A7;"
                                                Style="{StaticResource PreviewHeaderIconButtonStyle}"
                                                ToolTip="Open preview in a separate window" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <avalonEdit:TextEditor x:Name="PreviewEditor"
                                                           Background="{DynamicResource Theme.SurfaceBrush}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           HorizontalScrollBarVisibility="Auto"
                                                           IsReadOnly="True"
                                                           PreviewMouseWheel="PreviewEditor_PreviewMouseWheel"
                                                           ShowLineNumbers="True"
                                                           VerticalScrollBarVisibility="Auto"
                                                           Visibility="Collapsed" />
                                    <TextBlock x:Name="PreviewEmptyText"
                                               Margin="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                                               IsHitTestVisible="False"
                                               Text="Single-click a reference to preview it."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource Theme.PanelBrush}">
                <Grid x:Name="WorkspaceViewGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="CodeViewRow" Height="*" MinHeight="140" />
                        <RowDefinition x:Name="WorkspaceViewSplitterRow" Height="0" />
                        <RowDefinition x:Name="DiagramViewRow" Height="0" MinHeight="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CodeViewColumn" Width="*" MinWidth="140" />
                        <ColumnDefinition x:Name="WorkspaceViewSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="DiagramViewColumn" Width="0" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CodeViewHost"
                          Grid.Row="0"
                          Grid.Column="0"
                          PreviewMouseDown="CodeViewHost_PreviewMouseDown"
                          PreviewMouseMove="CodeViewHost_PreviewMouseMove"
                          PreviewMouseWheel="CodeViewHost_PreviewMouseWheel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Background="{DynamicResource Theme.SurfaceBrush}">
                            <DockPanel Margin="10,4">
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal">
                                    <ToggleButton x:Name="CodeCanvasModeToggle"
                                                  Width="70"
                                                  Height="23"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="CodeViewModeToggle_Checked"
                                                  Content="Canvas"
                                                  IsChecked="True"
                                                  Unchecked="CodeViewModeToggle_Unchecked" />
                                    <ToggleButton x:Name="CodeTabModeToggle"
                                                  Width="70"
                                                  Height="23"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="CodeViewModeToggle_Checked"
                                                  Content="Tabs"
                                                  Unchecked="CodeViewModeToggle_Unchecked" />
                                    <Border x:Name="ReferenceConnectionLinesSeparator"
                                            Width="1"
                                            Height="22"
                                            Margin="10,0,4,0"
                                            Background="{DynamicResource Theme.StrongBorderBrush}" />
                                    <ToggleButton x:Name="ReferenceConnectionLinesToggle"
                                                  Width="104"
                                                  Height="23"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="ReferenceConnectionLinesToggle_CheckedChanged"
                                                  Content="Ref Lines"
                                                  ToolTip="Reference Connection Lines"
                                                  Unchecked="ReferenceConnectionLinesToggle_CheckedChanged" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="WorkspaceScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="WorkspaceCanvas"
                                        Width="100000"
                                        Height="100000"
                                        Background="{DynamicResource Theme.PanelBrush}"
                                        MouseLeftButtonDown="WorkspaceCanvas_MouseLeftButtonDown"
                                        MouseLeftButtonUp="WorkspaceCanvas_MouseLeftButtonUp"
                                        MouseMove="WorkspaceCanvas_MouseMove"
                                        MouseWheel="WorkspaceCanvas_MouseWheel">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform x:Name="WorkspaceScaleTransform"
                                                        ScaleX="1"
                                                        ScaleY="1" />
                                    </Canvas.LayoutTransform>
                                </Canvas>
                            </ScrollViewer>
                            <TabControl x:Name="CodeDocumentsTabControl"
                                        BorderThickness="0"
                                        SelectionChanged="CodeDocumentsTabControl_SelectionChanged"
                                        Visibility="Collapsed" />
                            <TextBlock x:Name="EmptyWorkspaceHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       IsHitTestVisible="False"
                                       Text="Open a folder, then double-click a file to view it." />
                            <TextBlock x:Name="EmptyCodeTabsHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       IsHitTestVisible="False"
                                       Text="Open a folder, then double-click a file to view it."
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <GridSplitter x:Name="WorkspaceViewSplitter"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource Theme.BorderBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  Visibility="Collapsed" />

                    <Grid x:Name="DiagramViewHost"
                          Grid.Row="2"
                          Grid.Column="0"
                          PreviewMouseDown="DiagramViewHost_PreviewMouseDown"
                          PreviewMouseMove="DiagramViewHost_PreviewMouseMove"
                          PreviewMouseWheel="DiagramViewHost_PreviewMouseWheel"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DiagramContentColumn"
                                              Width="*"
                                              MinWidth="220" />
                            <ColumnDefinition x:Name="DiagramSidebarSplitterColumn"
                                              Width="0" />
                            <ColumnDefinition x:Name="DiagramSidebarColumn"
                                              Width="0"
                                              MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{DynamicResource Theme.SurfaceBrush}">
                                <DockPanel Margin="10,4" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                        <ProgressBar x:Name="DiagramExportProgressBar"
                                                     Width="120"
                                                     Height="8"
                                                     Margin="0,9,8,0"
                                                     Maximum="100"
                                                     Minimum="0"
                                                     Visibility="Collapsed" />
                                        <Button x:Name="NewDiagramButton"
                                                Width="64"
                                                Height="26"
                                                Margin="0,0,8,0"
                                                Padding="8,0"
                                                Background="#1E3A8A"
                                                Style="{StaticResource RoundedToolbarButtonStyle}"
                                                Click="NewDiagramButton_Click"
                                                Content="New"
                                                ToolTip="Create a new blank diagram" />
                                        <Button x:Name="ExportDiagramButton"
                                                Width="86"
                                                Height="26"
                                                Margin="0,0,8,0"
                                                Padding="8,0"
                                                Background="#0F766E"
                                                Style="{StaticResource RoundedToolbarButtonStyle}"
                                                Click="ExportDiagramButton_Click"
                                                ToolTip="Export the diagram">
                                            <Button.ContextMenu>
                                                <ContextMenu Padding="4"
                                                             BorderBrush="{DynamicResource Theme.StrongBorderBrush}"
                                                             BorderThickness="1"
                                                             Background="{DynamicResource Theme.SurfaceBrush}">
                                                    <Button Width="116"
                                                            Height="28"
                                                            Margin="0,0,0,4"
                                                            Padding="8,0"
                                                            Background="#0F766E"
                                                            Style="{StaticResource RoundedToolbarButtonStyle}"
                                                            Click="ExportDiagramPngMenuButton_Click"
                                                            Content="PNG"
                                                            ToolTip="Export the entire diagram as a PNG" />
                                                    <Button Width="116"
                                                            Height="28"
                                                            Padding="8,0"
                                                            Background="#2563EB"
                                                            Style="{StaticResource RoundedToolbarButtonStyle}"
                                                            Click="ExportDiagramPdfMenuButton_Click"
                                                            Content="PDF"
                                                            ToolTip="Export the diagram and documentation as a linked PDF" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Export" />
                                                <Polygon Width="8"
                                                         Height="5"
                                                         Margin="6,1,0,0"
                                                         VerticalAlignment="Center"
                                                         Fill="White"
                                                         Points="0,0 8,0 4,5" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SaveDiagramButton"
                                                Width="64"
                                                Height="26"
                                                Padding="8,0"
                                                Style="{StaticResource GreenToolbarButtonStyle}"
                                                Click="SaveDiagramButton_Click"
                                                Content="Save" />
                                        <Button x:Name="SaveDiagramAsButton"
                                                Width="78"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Padding="8,0"
                                                Background="#2563EB"
                                                Style="{StaticResource RoundedToolbarButtonStyle}"
                                                Click="SaveDiagramAsButton_Click"
                                                Content="Save As"
                                                IsEnabled="{Binding CanSaveDiagramAs}" />
                                        <Button x:Name="DeleteDiagramButton"
                                                Width="72"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Padding="8,0"
                                                Style="{StaticResource RedToolbarButtonStyle}"
                                                Click="DeleteDiagramButton_Click"
                                                Content="Delete"
                                                IsEnabled="{Binding CanDeleteDiagram}" />
                                        <Button x:Name="DiagramPopOutButton"
                                                Width="32"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Padding="0"
                                                Background="#111827"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource RoundedToolbarButtonStyle}"
                                                Click="DiagramPopOutButton_Click"
                                                Content="&#xE8A7;"
                                                ToolTip="Pop out diagram view" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Left"
                                                Orientation="Horizontal">
                                    <ToggleButton x:Name="DiagramSelectionToolButton"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="DiagramToolButton_Checked"
                                                  ToolTip="Selection Tool">
                                        <Rectangle Width="16"
                                                   Height="12"
                                                   Fill="Transparent"
                                                   Stroke="{DynamicResource Theme.IconStrokeBrush}"
                                                   StrokeDashArray="2,2"
                                                   StrokeThickness="1.6" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="DiagramRectangleToolButton"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="DiagramToolButton_Checked"
                                                  ToolTip="Rectangle">
                                        <Rectangle Width="15"
                                                   Height="11"
                                                   Fill="Transparent"
                                                   RadiusX="1"
                                                   RadiusY="1"
                                                   Stroke="{DynamicResource Theme.IconStrokeBrush}"
                                                   StrokeThickness="2" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="DiagramEllipseToolButton"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="DiagramToolButton_Checked"
                                                  ToolTip="Ellipse">
                                        <Ellipse Width="15"
                                                 Height="13"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource Theme.IconStrokeBrush}"
                                                 StrokeThickness="2" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="DiagramImageToolButton"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="DiagramToolButton_Checked"
                                                  Click="DiagramImageToolButton_Click"
                                                  ToolTip="Image">
                                        <ToggleButton.ContextMenu>
                                            <ContextMenu Closed="DiagramImageToolMenu_Closed" />
                                        </ToggleButton.ContextMenu>
                                        <Grid Width="28"
                                              Height="17">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="17"
                                                  Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Rectangle Fill="Transparent"
                                                           Stroke="{DynamicResource Theme.IconStrokeBrush}"
                                                           StrokeThickness="1.6" />
                                                <Polygon Points="2,12 6,7 9,10 12,5 15,12"
                                                         Fill="{DynamicResource Theme.IconStrokeBrush}" />
                                                <Ellipse Width="3"
                                                         Height="3"
                                                         Margin="3,2,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Top"
                                                         Fill="{DynamicResource Theme.IconStrokeBrush}" />
                                            </Grid>
                                            <Polygon Grid.Column="1"
                                                     Width="5"
                                                     Height="3"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource Theme.SubtleTextBrush}"
                                                     Points="0,0 5,0 2.5,3" />
                                        </Grid>
                                    </ToggleButton>
                                    <ToggleButton x:Name="DiagramLineToolButton"
                                                  Margin="6,0,0,0"
                                                  Style="{StaticResource DiagramToolToggleButtonStyle}"
                                                  Checked="DiagramToolButton_Checked"
                                                  Click="DiagramLineToolButton_Click"
                                                  ToolTip="Line">
                                        <ToggleButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="DiagramLineEndArrowMenuItem"
                                                          Header="Arrow at end"
                                                          IsCheckable="True"
                                                          Click="DiagramLineEndArrowMenuItem_Click" />
                                            </ContextMenu>
                                        </ToggleButton.ContextMenu>
                                        <Grid Width="28"
                                              Height="17">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                            </Grid.ColumnDefinitions>
                                            <Canvas Width="17"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Line X1="2"
                                                      Y1="11"
                                                      X2="15"
                                                      Y2="3"
                                                      Stroke="{DynamicResource Theme.IconStrokeBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                            <Polygon Grid.Column="1"
                                                     Width="5"
                                                     Height="3"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource Theme.SubtleTextBrush}"
