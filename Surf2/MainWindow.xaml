                                                             Height="24"
                                                             Margin="8,0,0,0"
                                                             VerticalContentAlignment="Center" />
                                                </Grid>

                                                <ToggleButton x:Name="WorkflowAddItemsToggleButton"
                                                              Grid.Row="2"
                                                              Height="30"
                                                              HorizontalAlignment="Stretch"
                                                              Style="{StaticResource WorkflowSidebarToggleStyle}"
                                                              Click="WorkflowAddItemsToggleButton_Click"
                                                              Content="Add Items: OFF" />

                                                <ScrollViewer x:Name="WorkflowItemsScrollViewer"
                                                              Grid.Row="3"
                                                              Margin="0,10,0,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <StackPanel x:Name="WorkflowItemsPanel" />
                                                        <TextBlock x:Name="WorkflowItemsPlaceholder"
                                                                   Margin="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Theme.MutedTextBrush}"
                                                                   Text="No workflow items yet."
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center" />
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Background="{DynamicResource Theme.SurfaceAltBrush}">
                                    <Button x:Name="DiagramSidebarSaveButton"
                                            Width="88"
                                            Height="28"
                                            Margin="0,8,12,8"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource GreenToolbarButtonStyle}"
                                            Click="DiagramSidebarSaveButton_Click"
                                            Content="Save" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="MainCanvasLoadingOverlay"
                          Grid.RowSpan="3"
                          Grid.ColumnSpan="3"
                          Panel.ZIndex="100"
                          Background="{DynamicResource Theme.OverlayBrush}"
                          Visibility="Visible">
                        <Border MinWidth="230"
                                MaxWidth="360"
                                Padding="20,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.SurfaceBrush}"
                                BorderBrush="{DynamicResource Theme.StrongBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="42"
                                      Height="42"
                                      HorizontalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform />
                                    </Grid.RenderTransform>
                                    <Ellipse Width="36"
                                             Height="36"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stroke="{DynamicResource Theme.BorderBrush}"
                                             StrokeThickness="4" />
                                    <Path Data="M21,3 A18,18 0 0 1 39,21"
                                          Stroke="{DynamicResource Theme.AccentBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="4" />
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0"
                                                                     To="360"
                                                                     Duration="0:0:0.85"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                                <TextBlock x:Name="MainCanvasLoadingText"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.TextBrush}"
                                           Text="Loading Surf 2.0..." />
                                <TextBlock x:Name="MainCanvasLoadingDetailText"
                                           MaxWidth="300"
                                           MaxHeight="54"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Theme.MutedTextBrush}"
                                           Text="Loading workspace data..."
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Theme.SurfaceBrush}">
            <TextBlock Margin="10,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.SubtleTextBrush}"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
