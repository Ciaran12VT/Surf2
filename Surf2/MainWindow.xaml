<Window x:Class="Surf2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Surf2.Models"
        mc:Ignorable="d"
        Title="Surf 2.0"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="600"
        Background="#F6F7F9"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemNode}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True" MinHeight="22">
                <TextBlock Width="18"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding AccentBrush}"
                           Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding TextBrush}"
                           Text="{Binding Name}" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <DockPanel Margin="10,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="108"
                            Height="30"
                            Click="SettingsButton_Click"
                            Content="Settings" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="116"
                            Height="30"
                            Click="ScopesButton_Click"
                            Content="Scopes" />
                    <Button Width="108"
                            Height="30"
                            Margin="8,0,0,0"
                            Click="CloseAllButton_Click"
                            Content="Close All" />
                </StackPanel>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="{Binding CurrentFolderDisplay}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7DCE2"
                    BorderThickness="0,0,1,0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="#E4E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="Object Explorer" />
                    </Border>
                    <TreeView x:Name="ObjectExplorer"
                              Grid.Row="1"
                              BorderThickness="0"
                              ItemsSource="{Binding RootNodes}"
                              MouseDoubleClick="ObjectExplorer_MouseDoubleClick"
                              TreeViewItem.PreviewMouseDoubleClick="ObjectExplorerItem_PreviewMouseDoubleClick"
                              TreeViewItem.Expanded="ObjectExplorerItem_Expanded" />
                    <GridSplitter Grid.Row="2"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#D7DCE2"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" />
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="#E4E7EB"
                                BorderThickness="0,1,0,1"
                                Padding="10,8">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Open Windows" />
                        </Border>
                        <ListBox x:Name="OpenTabsList"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 ItemsSource="{Binding OpenTabs}"
                                 PreviewMouseLeftButtonUp="OpenTabsList_PreviewMouseLeftButtonUp"
                                 ContextMenuOpening="OpenTabsList_ContextMenuOpening"
                                 SelectionChanged="OpenTabsList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="CloseOpenTabMenuItem_Click"
                                              Header="Close" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                 Handler="OpenTabsListItem_PreviewMouseRightButtonDown" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:OpenWindowItem}">
                                    <TextBlock Padding="8,5"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#D7DCE2" />

            <Border Grid.Column="2" Background="#EEF1F5">
                <Grid>
                    <ScrollViewer x:Name="WorkspaceScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="WorkspaceCanvas"
                                Width="100000"
                                Height="100000"
                                Background="#EEF1F5"
                                MouseLeftButtonDown="WorkspaceCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="WorkspaceCanvas_MouseLeftButtonUp"
                                MouseMove="WorkspaceCanvas_MouseMove"
                                MouseWheel="WorkspaceCanvas_MouseWheel">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="WorkspaceScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyWorkspaceHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#7B8794"
                               IsHitTestVisible="False"
                               Text="Open a folder, then double-click a file to view it." />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Background="#FFFFFF">
            <TextBlock Margin="10,0"
                       VerticalAlignment="Center"
                       Foreground="#4B5563"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
