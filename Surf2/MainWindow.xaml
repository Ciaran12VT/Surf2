<Window x:Class="Surf2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:models="clr-namespace:Surf2.Models"
        mc:Ignorable="d"
        Title="Surf 2.0"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="600"
        Background="#F6F7F9"
        Closing="Window_Closing"
        Icon="Assets/surf2_icon.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="RoundedToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#16A34A" />
        </Style>

        <Style x:Key="RedToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="BlueToolbarButtonStyle"
               BasedOn="{StaticResource RoundedToolbarButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E3A8A" />
        </Style>

        <Style x:Key="CircleToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#93C5FD" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegexToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#A0A7B0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewModeToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagramToolToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E0ECFF" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#BFDBFE" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagramToolButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E0ECFF" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#BFDBFE" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowSidebarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E0ECFF" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#BFDBFE" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitOrientationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemNode}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True" MinHeight="22">
                <TextBlock Width="18"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding AccentBrush}"
                           Text="{Binding Glyph}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding TextBrush}"
                           Text="{Binding Name}" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <DockPanel Margin="10,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="WorkbenchSelector"
                              Width="240"
                              Height="30"
                              Margin="0,0,8,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding SavedWorkbenches}"
                              SelectionChanged="WorkbenchSelector_SelectionChanged"
                              ToolTip="Load saved Workbench" />
                    <Button Width="138"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource GreenToolbarButtonStyle}"
                            Click="SaveWorkbenchButton_Click"
                            Content="Save Workbench" />
                    <Button Width="82"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource BlueToolbarButtonStyle}"
                            Click="SaveWorkbenchAsButton_Click"
                            Content="Save As" />
                    <Button x:Name="DeleteWorkbenchButton"
                            Width="76"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource RedToolbarButtonStyle}"
                            Click="DeleteWorkbenchButton_Click"
                            Content="Delete"
                            IsEnabled="False" />
                    <Button Style="{StaticResource SettingsCogButtonStyle}"
                            Click="SettingsButton_Click"
                            Content="&#xE713;"
                            ToolTip="Settings" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="116"
                            Height="30"
                            Style="{StaticResource GreenToolbarButtonStyle}"
                            Click="ScopesButton_Click"
                            Content="Scopes" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource CircleToolbarButtonStyle}"
                            Click="BackButton_Click"
                            Content="&#x2190;"
                            IsEnabled="{Binding CanNavigateBack}"
                            ToolTip="Back" />
                    <Button Margin="4,0,0,0"
                            Style="{StaticResource CircleToolbarButtonStyle}"
                            Click="ForwardButton_Click"
                            Content="&#x2192;"
                            IsEnabled="{Binding CanNavigateForward}"
                            ToolTip="Forward" />
                    <Button Width="108"
                            Height="30"
                            Margin="8,0,0,0"
                            Style="{StaticResource RedToolbarButtonStyle}"
                            Click="CloseAllButton_Click"
                            Content="Close All" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ToggleButton x:Name="CodeViewToggle"
                                  Style="{StaticResource ViewModeToggleStyle}"
                                  Checked="ViewToggle_CheckedChanged"
                                  Content="Code"
                                  IsChecked="True"
                                  MouseDoubleClick="ViewToggle_MouseDoubleClick"
                                  Unchecked="ViewToggle_CheckedChanged" />
                    <ToggleButton x:Name="DiagramViewToggle"
                                  Margin="12,0,0,0"
                                  Style="{StaticResource ViewModeToggleStyle}"
                                  Checked="ViewToggle_CheckedChanged"
                                  Content="Diagram"
                                  MouseDoubleClick="ViewToggle_MouseDoubleClick"
                                  Unchecked="ViewToggle_CheckedChanged" />
                    <Button x:Name="SplitOrientationButton"
                            Margin="10,0,0,0"
                            Style="{StaticResource SplitOrientationButtonStyle}"
                            Click="SplitOrientationButton_Click"
                            ToolTip="Enable Code and Diagram to change split orientation">
                        <Grid x:Name="SplitOrientationIcon"
                              Width="32"
                              Height="32"
                              IsHitTestVisible="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SplitOrientationIconRotation" Angle="270" />
                            </Grid.RenderTransform>
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="16,16"
                                                     RadiusX="15"
                                                     RadiusY="15" />
                                </Grid.Clip>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFFFFF" />
                                <Border Grid.Column="1"
                                        Background="#374151" />
                                <Border Grid.Column="2"
                                        Background="#D1D5DB" />
                            </Grid>
                            <Ellipse Fill="Transparent"
                                     Stroke="#6B7280"
                                     StrokeThickness="1" />
                        </Grid>
                    </Button>
                </StackPanel>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="{Binding CurrentFolderDisplay}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7DCE2"
                    BorderThickness="0,0,1,0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="#E4E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="Object Explorer" />
                    </Border>
                    <Border Grid.Row="1"
                            BorderBrush="#E4E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Find:" />
                            <TextBox x:Name="ObjectExplorerSearchTextBox"
                                     Grid.Column="1"
                                     Height="24"
                                     Margin="6,0,6,0"
                                     KeyDown="ObjectExplorerSearchTextBox_KeyDown" />
                            <ToggleButton x:Name="ObjectExplorerRegexToggle"
                                          Grid.Column="2"
                                          Width="38"
                                          Height="24"
                                          Style="{StaticResource RegexToggleStyle}"
                                          Content="(.*)" />
                            <TextBlock Grid.Column="3"
                                       Margin="8,0,5,0"
                                       VerticalAlignment="Center"
                                       Text="in" />
                            <ComboBox x:Name="ObjectExplorerSearchTargetComboBox"
                                      Grid.Column="4"
                                      Width="82"
                                      Height="24"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Name" />
                                <ComboBoxItem Content="Content" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TreeView x:Name="ObjectExplorer"
                              Grid.Row="2"
                              BorderThickness="0"
                              ItemsSource="{Binding RootNodes}"
                              MouseDoubleClick="ObjectExplorer_MouseDoubleClick"
                              MouseMove="ObjectExplorer_MouseMove"
                              PreviewMouseLeftButtonDown="ObjectExplorer_PreviewMouseLeftButtonDown"
                              TreeViewItem.PreviewMouseDoubleClick="ObjectExplorerItem_PreviewMouseDoubleClick"
                              TreeViewItem.PreviewMouseRightButtonDown="ObjectExplorerItem_PreviewMouseRightButtonDown"
                              TreeViewItem.Expanded="ObjectExplorerItem_Expanded">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <GridSplitter Grid.Row="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#D7DCE2"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" />
                    <TabControl x:Name="ExplorerDetailTabs"
                                Grid.Row="4"
                                BorderBrush="#E4E7EB"
                                BorderThickness="0,1,0,0">
                        <TabItem x:Name="OpenWindowsTabItem"
                                 Header="Open Windows">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        BorderBrush="#E4E7EB"
                                        BorderThickness="0,0,0,1"
                                        Background="#F8FAFC"
                                        Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4B5563"
                                                   Text="Name" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4B5563"
                                                   Text="Type" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="OpenTabsList"
                                         Grid.Row="1"
                                         BorderThickness="0"
                                         ItemsSource="{Binding OpenTabs}"
                                         PreviewMouseLeftButtonUp="OpenTabsList_PreviewMouseLeftButtonUp"
                                         ContextMenuOpening="OpenTabsList_ContextMenuOpening"
                                         SelectionChanged="OpenTabsList_SelectionChanged">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="CloseOpenTabMenuItem_Click"
                                                      Header="Close" />
                                            <MenuItem Click="CloseAllButThisOpenTabMenuItem_Click"
                                                      Header="Close all but this" />
                                            <Separator />
                                            <MenuItem Click="CloseAllOpenTabsMenuItem_Click"
                                                      Header="Close all" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch" />
                                            <Setter Property="Padding"
                                                    Value="0" />
                                            <EventSetter Event="PreviewMouseRightButtonDown"
                                                         Handler="OpenTabsListItem_PreviewMouseRightButtonDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:OpenWindowItem}">
                                            <Grid MinHeight="26"
                                                  Background="{Binding TypeBackBrush}"
                                                  ToolTip="{Binding FilePath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Margin="8,0,4,0"
                                                           Foreground="Black"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,8,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="Black"
                                                           Text="{Binding Type}"
                                                           TextAlignment="Left" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="PreviewTabItem"
                                 Header="Preview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        BorderBrush="#E4E7EB"
                                        BorderThickness="0,0,0,1"
                                        Background="#F8FAFC"
                                        Padding="8,6">
                                    <TextBlock x:Name="PreviewHeaderText"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               Text="No reference selected"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid Grid.Row="1">
                                    <avalonEdit:TextEditor x:Name="PreviewEditor"
                                                           Background="#FFFFFF"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
