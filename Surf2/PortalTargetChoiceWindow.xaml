<Window x:Class="Surf2.PortalTargetChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Portal"
        Width="430"
        Height="180"
        MinWidth="400"
        MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="138"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="PlaceNewButton_Click"
                    Content="Place new portal point" />
            <Button x:Name="SelectExistingButton"
                    Width="112"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="SelectExistingButton_Click"
                    Content="Select existing" />
            <Button Width="78"
                    Height="28"
                    Click="CancelButton_Click"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
