<Window x:Class="Surf2.ScopeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scopes"
        Width="1060"
        Height="560"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Scopes" />
            <ListBox x:Name="ScopeList"
                     Grid.Row="1"
                     Margin="0,8,0,8"
                     DisplayMemberPath="Name"
                     SelectionChanged="ScopeList_SelectionChanged" />
            <UniformGrid Grid.Row="2" Columns="2">
                <Button Margin="0,0,4,0"
                        Click="NewScopeButton_Click"
                        Content="New" />
                <Button Margin="4,0,0,0"
                        Click="DeleteScopeButton_Click"
                        Content="Delete" />
            </UniformGrid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#D7DCE2" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Name" />
                <TextBox x:Name="NameTextBox"
                         Grid.Column="1"
                         Height="26" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Text="Description" />
                <TextBox x:Name="DescriptionTextBox"
                         Grid.Column="1"
                         MinHeight="58"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Text="Scoped Resources" />
                <ListView x:Name="ResourceList"
                          Grid.Row="1"
                          Margin="0,8,0,8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="170"
                                            DisplayMemberBinding="{Binding DisplayName}"
                                            Header="Name" />
                            <GridViewColumn Width="90"
                                            DisplayMemberBinding="{Binding ResourceTypeDisplay}"
                                            Header="Type" />
                            <GridViewColumn Width="300"
                                            DisplayMemberBinding="{Binding Details}"
                                            Header="Details" />
                            <GridViewColumn Width="150"
                                            DisplayMemberBinding="{Binding AddedDisplay}"
                                            Header="Added" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="82"
                            Margin="0,0,6,0"
                            Click="AddFolderButton_Click"
                            Content="Add Folder" />
                    <Button Grid.Column="1"
                            Width="70"
                            Margin="0,0,6,0"
                            Click="AddFileButton_Click"
                            Content="Add File" />
                    <Button Grid.Column="2"
                            Width="86"
                            Margin="0,0,6,0"
                            Click="AddProjectButton_Click"
                            Content="Add Project" />
                    <Button Grid.Column="3"
                            Width="96"
                            Margin="0,0,6,0"
                            Click="AddDatabaseButton_Click"
                            Content="Add Database" />
                    <Button Grid.Column="4"
                            Width="70"
                            Margin="0,0,6,0"
                            Click="RenameResourceButton_Click"
                            Content="Rename" />
                    <Button Grid.Column="5"
                            Width="70"
                            Margin="0,0,12,0"
                            Click="RemoveResourceButton_Click"
                            Content="Remove" />
                    <ComboBox x:Name="MergeScopeComboBox"
                              Grid.Column="7"
                              Width="170"
                              Margin="0,0,6,0"
                              DisplayMemberPath="Name" />
                    <Button Grid.Column="8"
                            Width="132"
                            Click="AddScopeResourcesButton_Click"
                            Content="Add Scope Resources" />
                </Grid>
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#4B5563" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="116"
                            Margin="0,0,8,0"
                            Click="SaveButton_Click"
                            Content="Save Changes" />
                    <Button Width="92"
                            Margin="0,0,8,0"
                            Click="OpenButton_Click"
                            Content="Open" />
                    <Button Width="86"
                            Click="CloseButton_Click"
                            Content="Close" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
