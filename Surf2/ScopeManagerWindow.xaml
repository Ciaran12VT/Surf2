<Window x:Class="Surf2.ScopeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scopes"
        Width="1300"
        Height="560"
        MinWidth="1000"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ScopeActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopePrimaryButtonStyle"
               BasedOn="{StaticResource ScopeActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E3A8A" />
        </Style>

        <Style x:Key="ScopeDangerButtonStyle"
               BasedOn="{StaticResource ScopeActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="ScopeSaveButtonStyle"
               BasedOn="{StaticResource ScopeActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#16A34A" />
        </Style>

        <Style x:Key="ScopeCloseButtonStyle"
               BasedOn="{StaticResource ScopeActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Scopes" />
            <ListBox x:Name="ScopeList"
                     Grid.Row="1"
                     Margin="0,8,0,8"
                     DisplayMemberPath="Name"
                     SelectionChanged="ScopeList_SelectionChanged" />
            <UniformGrid Grid.Row="2" Columns="2">
                <Button Margin="0,0,4,0"
                        Style="{StaticResource ScopePrimaryButtonStyle}"
                        Click="NewScopeButton_Click"
                        Content="New" />
                <Button Margin="4,0,0,0"
                        Style="{StaticResource ScopeDangerButtonStyle}"
                        Click="DeleteScopeButton_Click"
                        Content="Delete" />
            </UniformGrid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#D7DCE2" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Name" />
                <TextBox x:Name="NameTextBox"
                         Grid.Column="1"
                         Height="26" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Text="Description" />
                <TextBox x:Name="DescriptionTextBox"
                         Grid.Column="1"
                         MinHeight="58"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Text="Scoped Resources" />
                <ListView x:Name="ResourceList"
                          Grid.Row="1"
                          Margin="0,8,0,8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="170"
                                            DisplayMemberBinding="{Binding DisplayName}"
                                            Header="Name" />
                            <GridViewColumn Width="90"
                                            DisplayMemberBinding="{Binding ResourceTypeDisplay}"
                                            Header="Type" />
                            <GridViewColumn Width="300"
                                            DisplayMemberBinding="{Binding Details}"
                                            Header="Details" />
                            <GridViewColumn Width="150"
                                            DisplayMemberBinding="{Binding AddedDisplay}"
                                            Header="Added" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="96"
                            Margin="0,0,6,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="AddFolderButton_Click"
                            Content="Add Folder" />
                    <Button Grid.Column="1"
                            Width="84"
                            Margin="0,0,6,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="AddFileButton_Click"
                            Content="Add File" />
                    <Button Grid.Column="2"
                            Width="120"
                            Margin="0,0,6,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="AddDatabaseButton_Click"
                            Content="Add Database" />
                    <Button Grid.Column="3"
                            Width="92"
                            Margin="0,0,6,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="EditResourceButton_Click"
                            Content="Edit" />
                    <Button Grid.Column="4"
                            Width="92"
                            Margin="0,0,6,0"
                            Style="{StaticResource ScopeDangerButtonStyle}"
                            Click="RemoveResourceButton_Click"
                            Content="Remove" />
                    <Button Grid.Column="5"
                            Width="116"
                            Margin="0,0,12,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="AddExistingResourceButton_Click"
                            Content="Add Existing" />
                    <ComboBox x:Name="MergeScopeComboBox"
                              Grid.Column="7"
                              Width="170"
                              Margin="0,0,6,0"
                              DisplayMemberPath="Name" />
                    <Button Grid.Column="8"
                            Width="170"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="AddScopeResourcesButton_Click"
                            Content="Add Scope Resources" />
                </Grid>
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#4B5563" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ScopeSaveButtonStyle}"
                            Click="SaveButton_Click"
                            Content="Save Changes" />
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Style="{StaticResource ScopePrimaryButtonStyle}"
                            Click="OpenButton_Click"
                            Content="Open" />
                    <Button Width="92"
                            Style="{StaticResource ScopeCloseButtonStyle}"
                            Click="CloseButton_Click"
                            Content="Close" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
