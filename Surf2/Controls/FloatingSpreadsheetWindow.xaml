<UserControl x:Class="Surf2.Controls.FloatingSpreadsheetWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="360"
             MinHeight="240"
             ContextMenuOpening="FloatingSpreadsheetWindow_ContextMenuOpening">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="4" />
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Click="CloseContextMenuItem_Click"
                      Header="Close" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border BorderBrush="#687385"
            BorderThickness="1"
            Background="#FFFFFF"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar"
                  Grid.Row="0"
                  Background="#253245"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                  MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp"
                  MouseMove="HeaderBar_MouseMove">
                <TextBlock x:Name="TitleText"
                           Margin="10,0,38,0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="CloseButton"
                        Panel.ZIndex="2"
                        Width="24"
                        Height="24"
                        Margin="0,4,5,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Content="X"
                        FontSize="11"
                        FontWeight="Bold" />
            </Grid>

            <Grid Grid.Row="1">
                <DataGrid x:Name="SpreadsheetGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="True"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          IsReadOnly="False"
                          RowHeaderWidth="0"
                          SelectionUnit="CellOrRowHeader"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" />

                <Border x:Name="LoadingOverlay"
                        Background="#F8FAFC"
                        Visibility="Visible">
                    <TextBlock x:Name="LoadingText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Loading CSV..." />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#D1D5DB"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="8,0">
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#4B5563" />
                    <Button DockPanel.Dock="Right"
                            Width="82"
                            Height="18"
                            Margin="8,2,0,2"
                            Click="ClearFiltersButton_Click"
                            Content="Clear Filters"
                            FontSize="10" />
                </DockPanel>
            </Border>

            <primitives:Thumb Grid.RowSpan="3"
                              Width="6"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              Cursor="SizeWE"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="3"
                              Tag="Left" />
            <primitives:Thumb Grid.RowSpan="3"
                              Width="6"
                              HorizontalAlignment="Right"
                              Background="Transparent"
                              Cursor="SizeWE"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="3"
                              Tag="Right" />
            <primitives:Thumb Grid.RowSpan="3"
                              Height="6"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              Cursor="SizeNS"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="3"
                              Tag="Top" />
            <primitives:Thumb Grid.RowSpan="3"
                              Height="6"
                              VerticalAlignment="Bottom"
                              Background="Transparent"
                              Cursor="SizeNS"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="3"
                              Tag="Bottom" />
            <primitives:Thumb Grid.RowSpan="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              Cursor="SizeNWSE"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="4"
                              Tag="TopLeft" />
            <primitives:Thumb Grid.RowSpan="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              Cursor="SizeNESW"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="4"
                              Tag="TopRight" />
            <primitives:Thumb Grid.RowSpan="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Background="Transparent"
                              Cursor="SizeNESW"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="4"
                              Tag="BottomLeft" />
            <primitives:Thumb Grid.RowSpan="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Background="#D5DAE1"
                              Cursor="SizeNWSE"
                              DragDelta="ResizeThumb_DragDelta"
                              Panel.ZIndex="4"
                              Tag="BottomRight" />
        </Grid>
    </Border>
</UserControl>
