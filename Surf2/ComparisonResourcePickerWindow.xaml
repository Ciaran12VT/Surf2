<Window x:Class="Surf2.ComparisonResourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Resource to Compare"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ComparisonActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Filter:" />
            <TextBox x:Name="FilterTextBox"
                     Grid.Column="1"
                     Height="26"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     TextChanged="FilterTextBox_TextChanged" />
        </Grid>

        <ListView x:Name="ResourcesListView"
                  Grid.Row="1"
                  MouseDoubleClick="ResourcesListView_MouseDoubleClick"
                  SelectionChanged="ResourcesListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="230"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                    <GridViewColumn Width="150"
                                    DisplayMemberBinding="{Binding Type}"
                                    Header="Type" />
                    <GridViewColumn Width="340"
                                    DisplayMemberBinding="{Binding Path}"
                                    Header="Path" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#64748B" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PickButton"
                        Width="84"
                        Margin="0,0,8,0"
                        Background="#1E3A8A"
                        Click="PickButton_Click"
                        Content="Pick"
                        IsEnabled="False"
                        Style="{StaticResource ComparisonActionButtonStyle}" />
                <Button Width="84"
                        Background="#111827"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        Style="{StaticResource ComparisonActionButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
