<Window x:Class="Surf2.ResourceFileDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diff="clr-namespace:DiffPlex.Wpf.Controls;assembly=DiffPlex.Wpf"
        Title="Resource Diff"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DiffMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E3A8A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#F8FAFC"
                Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <CheckBox x:Name="IgnoreWhitespaceCheckBox"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Checked="DiffOptionCheckBox_CheckedChanged"
                              Content="Ignore whitespace"
                              Foreground="#1F2937"
                              Unchecked="DiffOptionCheckBox_CheckedChanged" />
                    <CheckBox x:Name="IgnoreCaseCheckBox"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Checked="DiffOptionCheckBox_CheckedChanged"
                              Content="Ignore case"
                              Foreground="#1F2937"
                              Unchecked="DiffOptionCheckBox_CheckedChanged" />
                </StackPanel>
                <TextBlock x:Name="HeaderText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Panel.ZIndex="2"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#F8FAFC"
                Padding="12,6">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="SwitchModeButton"
                        MinWidth="104"
                        Click="SwitchModeButton_Click"
                        Content="Unified"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Switch between split and unified views" />
                <Button MinWidth="84"
                        Click="PreviousDiffButton_Click"
                        Content="Previous"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Go to previous change" />
                <Button MinWidth="64"
                        Click="NextDiffButton_Click"
                        Content="Next"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Go to next change" />
                <TextBlock Margin="14,0,6,0"
                           VerticalAlignment="Center"
                           Text="Go to" />
                <TextBox x:Name="GoToLineTextBox"
                         Width="80"
                         Height="26"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="GoToLineTextBox_PreviewKeyDown" />
                <Button MinWidth="52"
                        Margin="6,2,2,2"
                        Click="GoToButton_Click"
                        Content="Go"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Go to line number" />
                <Button MinWidth="78"
                        Margin="12,2,2,2"
                        Click="CopyLeftButton_Click"
                        Content="Copy left"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Copy the left file text to the clipboard" />
                <Button MinWidth="92"
                        Click="CopyLeftAsTextFileButton_Click"
                        Content="Left .txt"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Create a .txt file from the left text and copy the file to the clipboard" />
                <Button MinWidth="82"
                        Margin="8,2,2,2"
                        Click="CopyRightButton_Click"
                        Content="Copy right"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Copy the right file text to the clipboard" />
                <Button MinWidth="96"
                        Click="CopyRightAsTextFileButton_Click"
                        Content="Right .txt"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Create a .txt file from the right text and copy the file to the clipboard" />
                <TextBlock Margin="16,0,6,0"
                           VerticalAlignment="Center"
                           Text="Anchor" />
                <TextBlock Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Text="L" />
                <TextBox x:Name="LeftAnchorLineTextBox"
                         Width="58"
                         Height="26"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="AnchorLineTextBox_PreviewKeyDown"
                         ToolTip="Left line to align" />
                <TextBlock Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           Text="R" />
                <TextBox x:Name="RightAnchorLineTextBox"
                         Width="58"
                         Height="26"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="AnchorLineTextBox_PreviewKeyDown"
                         ToolTip="Right line to align" />
                <Button MinWidth="126"
                        Margin="8,2,2,2"
                        Click="AlignSelectedLinesButton_Click"
                        Content="Align selected lines"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Anchor the selected left and right lines and recalculate the diff" />
                <Button MinWidth="96"
                        Click="ClearAnchorsButton_Click"
                        Content="Clear anchors"
                        Style="{StaticResource DiffMenuButtonStyle}"
                        ToolTip="Remove all manual alignment anchors" />
                <TextBlock x:Name="AnchorStatusTextBlock"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           Text="No anchors" />
            </WrapPanel>
        </Border>

        <diff:DiffViewer x:Name="DiffViewer"
                         Grid.Row="2"
                         PreviewMouseLeftButtonDown="DiffViewer_PreviewMouseLeftButtonDown"
                         HeaderBackground="#253245"
                         HeaderForeground="White"
                         ImaginaryBackground="#F8FAFC"
                         InsertedBackground="#DCFCE7"
                         DeletedBackground="#FEE2E2"
                         UnchangedBackground="White"
                         IsCommandBarVisible="False"
                         IsOpenFileButtonVisible="False"
                         IsSideBySide="True" />
    </Grid>
</Window>
