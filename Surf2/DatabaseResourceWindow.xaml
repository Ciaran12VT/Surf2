<Window x:Class="Surf2.DatabaseResourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Database"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="QuerySplitButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SurfPrimaryButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12"
          Background="{DynamicResource Theme.WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="64" MaxHeight="190" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6*" MinHeight="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="Database name" />
            <TextBox x:Name="SnapshotNameTextBox"
                     Grid.Column="1"
                     Height="26" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top" Margin="0,0,8,0">
                <TextBlock Text="Full data tables" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                           TextWrapping="Wrap"
                           Text="One table per line. Right-click to add TOP 100 or WHERE." />
            </StackPanel>
            <TextBox x:Name="FullDataTablesTextBox"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Examples: dbo.Customers [TOP 100] or dbo.Customers [WHERE Id = 1]. A table name without a suffix exports all rows.">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="TOP 100"
                                  Tag=" [TOP 100]"
                                  Click="FullDataTableSnippetMenuItem_Click" />
                        <MenuItem Header="WHERE"
                                  Tag=" [WHERE Id = 1]"
                                  Click="FullDataTableSnippetMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Cut"
                                  Command="ApplicationCommands.Cut"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Copy"
                                  Command="ApplicationCommands.Copy"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Paste"
                                  Command="ApplicationCommands.Paste"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <Separator />
                        <MenuItem Header="Select All"
                                  Command="ApplicationCommands.SelectAll"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="8"
                      Margin="130,2,0,2"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Theme.BorderBrush}"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="Resize full data tables"
                      ToolTip="Drag to adjust the height of the full data tables list." />

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="2">
                <Grid Height="30" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyQueryButton"
                            Style="{StaticResource QuerySplitButtonStyle}"
                            Click="CopyQueryButton_Click"
                            Content="Copy Query to Clipboard"
                            ToolTip="Copy the complete metadata query as text."
                            Tag="8,0,0,8" />
                    <Button x:Name="QueryModeButton"
                            Grid.Column="1"
                            Padding="0"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1,0,0,0"
                            Style="{StaticResource QuerySplitButtonStyle}"
                            Click="QueryModeButton_Click"
                            Content="▾"
                            Tag="0,8,8,0"
                            AutomationProperties.Name="Choose query output mode"
                            ToolTip="Choose what the query button does. Selecting a mode does not run it.">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem x:Name="CopyQueryTextMenuItem"
                                          Header="Copy query text to clipboard"
                                          IsCheckable="True"
                                          IsChecked="True"
                                          Tag="ClipboardText"
                                          Click="QueryModeMenuItem_Click" />
                                <MenuItem x:Name="CopyQueryFileMenuItem"
                                          Header="Create .txt file and copy file to clipboard"
                                          IsCheckable="True"
                                          Tag="ClipboardFile"
                                          Click="QueryModeMenuItem_Click" />
                                <MenuItem x:Name="OpenQueryFileMenuItem"
                                          Header="Create .txt file and open folder"
                                          IsCheckable="True"
                                          Tag="FileExplorer"
                                          Click="QueryModeMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <Button Grid.Column="1"
                        Height="30"
                        Margin="6,0,0,0"
                        Style="{StaticResource SurfPrimaryButtonStyle}"
                        Click="PasteClipboardButton_Click"
                        Content="Paste from Clipboard" />
            </UniformGrid>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource Theme.SurfaceAltBrush}">
                <UniformGrid Columns="3">
                    <TextBlock x:Name="StoredProceduresCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="StoredProcedures"
                               Text="Stored Procedures: 0" />
                    <TextBlock x:Name="ViewsCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="Views"
                               Text="Views: 0" />
                    <TextBlock x:Name="FunctionsCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="Functions"
                               Text="Functions: 0" />
                    <TextBlock x:Name="TriggersCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="Triggers"
                               Text="Triggers: 0" />
                    <TextBlock x:Name="TablesCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="Tables"
                               Text="Tables: 0" />
                    <TextBlock x:Name="FieldsCountText"
                               Margin="0,0,12,8"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="Fields"
                               Text="Fields: 0" />
                    <TextBlock x:Name="PrimaryKeysCountText"
                               Margin="0,0,12,0"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="PrimaryKeys"
                               Text="Primary Keys: 0" />
                    <TextBlock x:Name="FullDataTablesCountText"
                               Margin="0,0,12,0"
                               Cursor="Hand"
                               MouseLeftButtonUp="EntityCountText_MouseLeftButtonUp"
                               Tag="FullDataTables"
                               Text="Full Data Tables: 0" />
                    <TextBlock x:Name="DataRowsCountText"
                               Margin="0,0,12,0"
                               Text="Data Rows: 0" />
                </UniformGrid>
            </Border>

            <TextBox x:Name="ImportMessagesTextBox"
                     Grid.Row="2"
                     Margin="0,12,0,0"
                     MinHeight="36"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.SubtleTextBrush}"
                       TextWrapping="Wrap"
                       Text="Copy the query, run it in SSMS, copy the result set, then paste it here." />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="AddButton"
                        Width="104"
                        Margin="0,0,8,0"
                        Style="{StaticResource SurfSaveButtonStyle}"
                        Click="AddButton_Click"
                        Content="Add"
                        IsEnabled="False" />
                <Button Width="86"
                        Style="{StaticResource SurfCloseButtonStyle}"
                        Click="CloseButton_Click"
                        Content="Close" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
