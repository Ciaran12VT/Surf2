<Window x:Class="Surf2.TableDataDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Data Diff"
        Width="1180"
        Height="720"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <DockPanel x:Name="FindPanel"
                       DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       Visibility="Collapsed">
                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Text="Find:" />
                <TextBox x:Name="SearchTextBox"
                         Width="260"
                         Height="26"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Find comparison rows" />
            </DockPanel>
            <TextBlock x:Name="HeaderText"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DataGrid x:Name="RowsDataGrid"
                  Grid.Row="1"
                  Margin="0,10,0,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Width="190"
                                    Binding="{Binding Key}"
                                    Header="Key" />
                <DataGridTextColumn Width="95"
                                    Binding="{Binding Status}"
                                    Header="Status" />
                <DataGridTextColumn Width="240"
                                    Binding="{Binding ChangedColumns}"
                                    Header="Changed Columns" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding LeftPreview}"
                                    Header="Left Row" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding RightPreview}"
                                    Header="Right Row" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <ContentControl x:Name="ResultCommands"
                            DockPanel.Dock="Right"
                            Focusable="False" />
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
