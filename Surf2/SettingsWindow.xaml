<Window x:Class="Surf2.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="1120"
        Height="590"
        MinWidth="1040"
        MinHeight="460"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SettingsActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle"
               BasedOn="{StaticResource SettingsActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E3A8A" />
        </Style>

        <Style x:Key="SettingsDangerButtonStyle"
               BasedOn="{StaticResource SettingsActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="SettingsSaveButtonStyle"
               BasedOn="{StaticResource SettingsActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#16A34A" />
        </Style>

        <Style x:Key="SettingsCloseButtonStyle"
               BasedOn="{StaticResource SettingsActionButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="12"
          Background="{DynamicResource Theme.WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Settings" />
            <ListBox x:Name="SectionList"
                     Grid.Row="1"
                     Margin="0,8,0,0"
                     SelectionChanged="SectionList_SelectionChanged">
                <ListBoxItem Content="Code Windows" IsSelected="True" />
                <ListBoxItem Content="Reference Highlights" />
                <ListBoxItem Content="Diagram Images" />
                <ListBoxItem Content="Keyboard Shortcuts" />
                <ListBoxItem Content="Resource Comparison" />
                <ListBoxItem Content="Workbench" />
                <ListBoxItem Content="Appearance" />
                <ListBoxItem Content="Persistence" />
                <ListBoxItem Content="Diagnostics" />
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Theme.BorderBrush}" />

        <Grid Grid.Column="2">
            <Grid x:Name="CodeWindowSettingsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Code Window Backcolors" />

                <ListBox x:Name="BackcolorList"
                         Grid.Row="1"
                         Margin="0,8,0,10"
                         SelectionChanged="BackcolorList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="28" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Extension}" />
                                <Border Grid.Column="1"
                                        Width="24"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Background="{Binding Backcolor}"
                                        BorderBrush="#9CA3AF"
                                        BorderThickness="1" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding Backcolor}" />
                                <TextBlock Grid.Column="3"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding Language}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Extension" />
                    <TextBox x:Name="ExtensionTextBox"
                             Grid.Column="1"
                             Height="26" />
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Backcolor" />
                    <TextBox x:Name="ColorTextBox"
                             Grid.Column="3"
                             Height="26"
                             Cursor="Hand"
                             PreviewMouseLeftButtonDown="ColorTextBox_PreviewMouseLeftButtonDown"
                             ToolTip="Click to pick a color"
                             TextChanged="ColorTextBox_TextChanged" />
                    <Button x:Name="PickColorButton"
                            Grid.Column="4"
                            Width="72"
                            Height="26"
                            Margin="8,0,0,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="PickColorButton_Click"
                            Content="Apply" />
                    <ComboBox x:Name="LanguageComboBox"
                              Grid.Column="5"
                              Height="26"
                              Margin="8,0,0,0"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              ToolTip="Language used for syntax highlighting, references, and context menus" />
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="ValidationText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.ErrorTextBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="80"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Click="AddButton_Click"
                                Content="Add" />
                        <Button x:Name="RemoveButton"
                                Width="80"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsDangerButtonStyle}"
                                Click="RemoveButton_Click"
                                Content="Remove" />
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="ReferenceHighlightSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Reference Highlight Styles" />

                <ListBox x:Name="HighlightStyleList"
                         Grid.Row="1"
                         Margin="0,8,0,10"
                         SelectionChanged="HighlightStyleList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="30" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Language}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding Kind}" />
                                <Border Grid.Column="2"
                                        Width="24"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Background="{Binding Foreground}"
                                        BorderBrush="#9CA3AF"
                                        BorderThickness="1" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding Foreground}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Reference" />
                    <TextBlock x:Name="HighlightTargetText"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               VerticalAlignment="Center"
                               Text="Font color" />
                    <TextBox x:Name="HighlightColorTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="26"
                             Margin="0,8,0,0"
                             TextChanged="HighlightColorTextBox_TextChanged" />
                    <Button x:Name="ApplyHighlightColorButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Width="72"
                            Height="26"
                            Margin="8,8,0,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="ApplyHighlightColorButton_Click"
                            Content="Apply" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="3"
                                Margin="10,8,0,0"
                                Orientation="Horizontal">
                        <Border x:Name="HighlightPreviewSwatch"
                                Width="42"
                                Height="24"
                                BorderBrush="#9CA3AF"
                                BorderThickness="1" />
                        <Button Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                Background="#B45309"
                                BorderBrush="#9CA3AF"
                                Click="HighlightPresetColorButton_Click"
                                Tag="#B45309"
                                ToolTip="Dark Orange" />
                        <Button Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                Background="#1D4ED8"
                                BorderBrush="#9CA3AF"
                                Click="HighlightPresetColorButton_Click"
                                Tag="#1D4ED8"
                                ToolTip="Blue" />
                        <Button Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                Background="#047857"
                                BorderBrush="#9CA3AF"
                                Click="HighlightPresetColorButton_Click"
                                Tag="#047857"
                                ToolTip="Green" />
                        <Button Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                Background="#7C3AED"
                                BorderBrush="#9CA3AF"
                                Click="HighlightPresetColorButton_Click"
                                Tag="#7C3AED"
                                ToolTip="Purple" />
                        <Button Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                Background="#BE123C"
                                BorderBrush="#9CA3AF"
                                Click="HighlightPresetColorButton_Click"
                                Tag="#BE123C"
                                ToolTip="Red" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <CheckBox x:Name="HighlightBoldCheckBox"
                                  Margin="0,0,16,0"
                                  Checked="HighlightStyleCheckBox_Changed"
                                  Content="Bold"
                                  Unchecked="HighlightStyleCheckBox_Changed" />
                        <CheckBox x:Name="HighlightItalicCheckBox"
                                  Margin="0,0,16,0"
                                  Checked="HighlightStyleCheckBox_Changed"
                                  Content="Italic"
                                  Unchecked="HighlightStyleCheckBox_Changed" />
                        <CheckBox x:Name="HighlightUnderlineCheckBox"
                                  Margin="0,0,20,0"
                                  Checked="HighlightStyleCheckBox_Changed"
                                  Content="Underline"
                                  Unchecked="HighlightStyleCheckBox_Changed" />
                        <TextBlock x:Name="HighlightPreviewText"
                                   VerticalAlignment="Center"
                                   Text="ReferencePreview" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="HighlightValidationText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.ErrorTextBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveHighlightButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="DiagramImageSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Diagram Images" />

                <ListBox x:Name="DiagramImageList"
                         Grid.Row="1"
                         Margin="0,8,0,10"
                         SelectionChanged="DiagramImageList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="30" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding SortOrder}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding ResourceTypeFilter}" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding NameRegex}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding ContentRegex}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                           Text="{Binding OriginalFileName}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Name" />
                    <TextBox x:Name="DiagramImageNameTextBox"
                             Grid.Column="1"
                             Height="26"
                             TextChanged="DiagramImageNameTextBox_TextChanged" />
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Resource" />
                    <ComboBox x:Name="DiagramImageResourceTypeComboBox"
                              Grid.Column="3"
                              Height="26"
                              SelectionChanged="DiagramImageResourceTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Any" />
                        <ComboBoxItem Content="File" />
                        <ComboBoxItem Content="Folder" />
                        <ComboBoxItem Content="Database" />
                        <ComboBoxItem Content="Diagram" />
                    </ComboBox>
                    <Button x:Name="ImportDiagramImageButton"
                            Grid.Column="4"
                            Width="94"
                            Height="26"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="ImportDiagramImageButton_Click"
                            Content="Import" />

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               VerticalAlignment="Center"
                               Text="Name Regex" />
                    <TextBox x:Name="DiagramImageNameRegexTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="4"
                             Height="26"
                             Margin="0,10,0,0"
                             TextChanged="DiagramImageNameRegexTextBox_TextChanged" />

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               VerticalAlignment="Center"
                               Text="Content Regex" />
                    <TextBox x:Name="DiagramImageContentRegexTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Grid.ColumnSpan="4"
                             Height="26"
                             Margin="0,10,0,0"
                             TextChanged="DiagramImageContentRegexTextBox_TextChanged" />

                    <TextBlock Grid.Row="3"
                               Margin="0,10,0,0"
                               VerticalAlignment="Top"
                               Text="Preview" />
                    <Border Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="4"
                            Width="150"
                            Height="92"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource Theme.StrongBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource Theme.SurfaceAltBrush}">
                        <Image x:Name="DiagramImagePreview"
                               Margin="6"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="DiagramImageFileText"
                               Grid.Row="3"
                               Grid.Column="1"
                               Grid.ColumnSpan="4"
                               Margin="164,10,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Theme.SubtleTextBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Name="DiagramImageValidationText"
                           Grid.Row="3"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource Theme.ErrorTextBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="4"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="ExportDiagramImagePackageButton"
                            Width="128"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="ExportDiagramImagePackageButton_Click"
                            Content="Export Package" />
                    <Button x:Name="ImportDiagramImagePackageButton"
                            Width="128"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="ImportDiagramImagePackageButton_Click"
                            Content="Import Package" />
                    <Button Width="80"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="AddDiagramImageButton_Click"
                            Content="Add" />
                    <Button x:Name="MoveDiagramImageUpButton"
                            Width="70"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="MoveDiagramImageUpButton_Click"
                            Content="Up" />
                    <Button x:Name="MoveDiagramImageDownButton"
                            Width="70"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="MoveDiagramImageDownButton_Click"
                            Content="Down" />
                    <Button x:Name="RemoveDiagramImageButton"
                            Width="80"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsDangerButtonStyle}"
                            Click="RemoveDiagramImageButton_Click"
                            Content="Remove" />
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Style="{StaticResource SettingsSaveButtonStyle}"
                            Click="SaveDiagramImagesButton_Click"
                            Content="Save" />
                    <Button Width="86"
                            Style="{StaticResource SettingsCloseButtonStyle}"
                            Click="CloseButton_Click"
                            Content="Close" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PersistenceSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Persistence Database" />

                <TextBlock x:Name="ConnectionOverrideText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource Theme.SubtleTextBrush}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Connection string" />
                    <TextBox x:Name="PersistenceConnectionStringTextBox"
                             Grid.Row="1"
                             MinHeight="90"
                             Margin="0,8,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button x:Name="TestConnectionButton"
                                Width="132"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Click="TestConnectionButton_Click"
                                Content="Test Connection" />
                        <Button x:Name="UseDefaultConnectionButton"
                                Width="116"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Click="UseDefaultConnectionButton_Click"
                                Content="Use Default" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button x:Name="ExportDatabaseButton"
                                Width="132"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Click="ExportDatabaseButton_Click"
                                Content="Export Database" />
                        <Button x:Name="ImportDatabaseButton"
                                Width="132"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Click="ImportDatabaseButton_Click"
                                Content="Import Database" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Margin="0,14,0,0"
                            Padding="10"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource Theme.SurfaceAltBrush}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Connection changes are used the next time Surf2 starts. " />
                            <Run Text="The environment variable SURF2_CONNECTION_STRING overrides this local setting when it is present." />
                        </TextBlock>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="PersistenceValidationText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SubtleTextBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SavePersistenceButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="KeyboardShortcutSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Keyboard Shortcuts" />

                <StackPanel Grid.Row="1"
                            Margin="0,14,0,0">
                    <CheckBox x:Name="CanvasCtrlMousePanningCheckBox"
                              Margin="0,0,0,12"
                              Content="Canvas: Ctrl + Mouse for Panning" />
                    <CheckBox x:Name="TabCtrlMouseScrollingCheckBox"
                              Margin="0,0,0,12"
                              Content="Tab View: Ctrl + Mouse for Scrolling" />
                    <CheckBox x:Name="CodeShiftAutoscrollCheckBox"
                              Margin="0,0,0,12"
                              Content="Code Window/Tab: Shift + Mouse for Autoscrolling" />
                    <CheckBox x:Name="CodeCtrlShiftScrollbarLockedScrollCheckBox"
                              Margin="0,0,0,12"
                              Content="Code Window/Tab: Ctrl + Shift + Mouse for Scrollbar-Locked Scrolling" />
                    <CheckBox x:Name="CodeCanvasShiftMousePanningCheckBox"
                              Margin="0,0,0,12"
                              Content="Code Canvas: Shift + Mouse for Canvas Autopanning" />
                    <CheckBox x:Name="CodeCanvasCtrlShiftMouseZoomingCheckBox"
                              Margin="0,0,0,12"
                              Content="Code Canvas: Ctrl + Shift + Mouse for Zoom" />
                    <CheckBox x:Name="CodeViewHistoryNavigationCheckBox"
                              Margin="0,0,0,12"
                              Content="Code View: Ctrl + '-' and '+' for Back and Forward" />
                    <CheckBox x:Name="ViewSwitchingCtrlNumberCheckBox"
                              Margin="0,0,0,12"
                              Content="View Switching with Ctrl + 1 and 2" />
                    <CheckBox x:Name="CodeTabCtrlASNavigationCheckBox"
                              Margin="0,0,0,12"
                              Content="Tab Mode: Ctrl + A and Ctrl + S for tab navigation" />
                    <CheckBox x:Name="DiagramSidebarToggleCheckBox"
                              Margin="0,0,0,12"
                              Content="Diagram View: Ctrl + Q for Sidebar Open/Close toggle" />
                    <CheckBox x:Name="DiagramWorkflowSidebarCheckBox"
                              Margin="0,0,0,12"
                              Content="Diagram View: Ctrl + W for Open Sidebar on Workflow Tab" />
                    <CheckBox x:Name="DiagramShiftMousePanningCheckBox"
                              Margin="0,0,0,12"
                              Content="Diagram View: Shift + Mouse for Canvas Autopanning" />
                    <CheckBox x:Name="DiagramCtrlShiftMouseZoomingCheckBox"
                              Content="Diagram View: Ctrl + Shift + Mouse for Zoom" />
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Padding="10"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource Theme.SurfaceAltBrush}">
                    <TextBlock TextWrapping="Wrap"
                               Text="These shortcuts control mouse-driven navigation helpers. Standard left-drag canvas panning and normal editor scrolling remain available." />
                </Border>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveKeyboardShortcutSettingsButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="AppearanceSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Appearance" />

                <Grid Grid.Row="1"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Theme" />
                    <ComboBox x:Name="AppearanceThemeComboBox"
                              Grid.Column="1"
                              Height="26">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveAppearanceSettingsButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="ResourceComparisonSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Resource Comparison" />

                <StackPanel Grid.Row="1"
                            Margin="0,14,0,0">
                    <CheckBox x:Name="IgnoreWhitespaceDefaultCheckBox"
                              Margin="0,0,0,12"
                              Content="Ignore whitespace by default" />
                    <CheckBox x:Name="IgnoreCaseDefaultCheckBox"
                              Content="Ignore case by default" />
                </StackPanel>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveResourceComparisonSettingsButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="WorkbenchSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Workbench" />

                <CheckBox x:Name="LoadMostRecentWorkbenchCheckBox"
                          Grid.Row="1"
                          Margin="0,14,0,0"
                          Content="Load the most recent saved Workbench on startup" />

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Padding="10"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource Theme.SurfaceAltBrush}">
                    <TextBlock TextWrapping="Wrap"
                               Text="When enabled, Surf2 starts from your newest explicitly saved Workbench. When disabled, Surf2 starts in its default empty state." />
                </Border>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveWorkbenchSettingsButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="DiagnosticsSettingsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="Diagnostics" />

                <CheckBox x:Name="EnableInternalLoggingCheckBox"
                          Grid.Row="1"
                          Margin="0,14,0,0"
                          Content="Enable internal logging" />

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Padding="10"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource Theme.SurfaceAltBrush}">
                    <TextBlock TextWrapping="Wrap"
                               Text="When enabled, Surf2 writes internal diagnostic logs to an internal-logs folder beside the app or to the per-user fallback location if that folder is not writable." />
                </Border>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsSaveButtonStyle}"
                                Click="SaveDiagnosticsSettingsButton_Click"
                                Content="Save" />
                        <Button Width="86"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                Content="Close" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
