<Window x:Class="Surf2.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="760"
        Height="500"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Settings" />
            <ListBox x:Name="SectionList"
                     Grid.Row="1"
                     Margin="0,8,0,0">
                <ListBoxItem Content="Code Windows" IsSelected="True" />
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#D7DCE2" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Code Window Backcolors" />

            <ListBox x:Name="BackcolorList"
                     Grid.Row="1"
                     Margin="0,8,0,10"
                     SelectionChanged="BackcolorList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="28" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Extension}" />
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{Binding Backcolor}"
                                    BorderBrush="#9CA3AF"
                                    BorderThickness="1" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"
                                       Text="{Binding Backcolor}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Extension" />
                <TextBox x:Name="ExtensionTextBox"
                         Grid.Column="1"
                         Height="26" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Backcolor" />
                <TextBox x:Name="ColorTextBox"
                         Grid.Column="3"
                         Height="26"
                         TextChanged="ColorTextBox_TextChanged" />
                <Button x:Name="PickColorButton"
                        Grid.Column="4"
                        Width="72"
                        Height="26"
                        Margin="8,0,0,0"
                        Click="PickColorButton_Click"
                        Content="Apply" />
                <StackPanel Grid.Column="5"
                            Margin="10,0,0,0"
                            Orientation="Horizontal">
                    <Border x:Name="PreviewSwatch"
                            Width="42"
                            Height="24"
                            BorderBrush="#9CA3AF"
                            BorderThickness="1" />
                    <Button Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            Background="#FFFFFF"
                            BorderBrush="#9CA3AF"
                            Click="PresetColorButton_Click"
                            Tag="#FFFFFF"
                            ToolTip="White" />
                    <Button Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Background="#EAF4FF"
                            BorderBrush="#9CA3AF"
                            Click="PresetColorButton_Click"
                            Tag="#EAF4FF"
                            ToolTip="Pale Blue" />
                    <Button Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Background="#FFF8D6"
                            BorderBrush="#9CA3AF"
                            Click="PresetColorButton_Click"
                            Tag="#FFF8D6"
                            ToolTip="Pale Yellow" />
                    <Button Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Background="#ECFDF3"
                            BorderBrush="#9CA3AF"
                            Click="PresetColorButton_Click"
                            Tag="#ECFDF3"
                            ToolTip="Pale Green" />
                    <Button Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Background="#FFF1F2"
                            BorderBrush="#9CA3AF"
                            Click="PresetColorButton_Click"
                            Tag="#FFF1F2"
                            ToolTip="Pale Pink" />
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="ValidationText"
                           VerticalAlignment="Center"
                           Foreground="#B91C1C" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="80"
                            Margin="0,0,8,0"
                            Click="AddButton_Click"
                            Content="Add" />
                    <Button x:Name="RemoveButton"
                            Width="80"
                            Margin="0,0,8,0"
                            Click="RemoveButton_Click"
                            Content="Remove" />
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Click="SaveButton_Click"
                            Content="Save" />
                    <Button Width="86"
                            Click="CloseButton_Click"
                            Content="Close" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
