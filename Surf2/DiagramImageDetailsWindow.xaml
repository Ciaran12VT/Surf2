<Window x:Class="Surf2.DiagramImageDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Details"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Label"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="LabelTextBox"
                     MinHeight="28"
                     VerticalContentAlignment="Center" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="Font size" />
                <ComboBox x:Name="LabelFontSizeComboBox"
                          Grid.Column="1"
                          Width="96"
                          Height="28"
                          HorizontalAlignment="Left"
                          ToolTip="Font size" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Height="28"
                    Style="{StaticResource SurfSaveButtonStyle}"
                    Content="Save"
                    Click="SaveButton_Click" />
            <Button Width="88"
                    Height="28"
                    Margin="8,0,0,0"
                    Style="{StaticResource SurfCloseButtonStyle}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
