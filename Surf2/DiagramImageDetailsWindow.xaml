<Window x:Class="Surf2.DiagramImageDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Details"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Image"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ImagePreview"
                       Height="64"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ImageNameText"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />
                    <Button x:Name="ChangeImageButton"
                            Content="Change Image"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SurfPrimaryButtonStyle}"
                            Click="ChangeImageButton_Click" />
                </StackPanel>
            </Grid>
            <Popup x:Name="ImagePickerPopup"
                   PlacementTarget="{Binding ElementName=ChangeImageButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   Opened="ImagePickerPopup_Opened"
                   Closed="ImagePickerPopup_Closed">
                <Border Width="310"
                        Padding="6"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        PreviewKeyDown="ImagePicker_PreviewKeyDown">
                    <StackPanel>
                        <TextBlock Text="Saved images" FontWeight="SemiBold" Margin="6,4,6,8" />
                        <TextBlock x:Name="NoImagesText"
                                   Text="No saved images available."
                                   Foreground="{DynamicResource Theme.SubtleTextBrush}"
                                   Margin="6,0,6,10"
                                   Visibility="Collapsed" />
                        <ListBox x:Name="SavedImagesList"
                                 MaxHeight="240"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SavedImagesList_SelectionChanged"
                                 AutomationProperties.Name="Saved images">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Source}" Width="32" Height="32" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Definition.Name}"
                                                   ToolTip="{Binding Definition.Name}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Separator Margin="0,6" />
                        <Button x:Name="BrowseImageButton"
                                Content="Browse computer…"
                                Style="{StaticResource SurfPrimaryButtonStyle}"
                                Click="BrowseImageButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock x:Name="ImageErrorText"
                       Foreground="{DynamicResource Theme.ErrorTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="Collapsed" />
            <TextBlock Text="Label"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="LabelTextBox"
                     MinHeight="28"
                     VerticalContentAlignment="Center" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="Font size" />
                <ComboBox x:Name="LabelFontSizeComboBox"
                          Grid.Column="1"
                          Width="96"
                          Height="28"
                          HorizontalAlignment="Left"
                          ToolTip="Font size" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Height="28"
                    Style="{StaticResource SurfSaveButtonStyle}"
                    Content="Save"
                    Click="SaveButton_Click" />
            <Button Width="88"
                    Height="28"
                    Margin="8,0,0,0"
                    Style="{StaticResource SurfCloseButtonStyle}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
