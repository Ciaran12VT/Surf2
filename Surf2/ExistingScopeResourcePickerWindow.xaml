<Window x:Class="Surf2.ExistingScopeResourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Existing Resources"
        Width="820"
        Height="540"
        MinWidth="620"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Filter:" />
            <TextBox x:Name="FilterTextBox"
                     Grid.Column="1"
                     Height="26"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     TextChanged="FilterTextBox_TextChanged" />
        </Grid>

        <ListView x:Name="ResourcesListView"
                  Grid.Row="1"
                  MouseDoubleClick="ResourcesListView_MouseDoubleClick"
                  SelectionChanged="ResourcesListView_SelectionChanged"
                  SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="210"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                    <GridViewColumn Width="100"
                                    DisplayMemberBinding="{Binding Type}"
                                    Header="Type" />
                    <GridViewColumn Width="160"
                                    DisplayMemberBinding="{Binding Source}"
                                    Header="Source" />
                    <GridViewColumn Width="300"
                                    DisplayMemberBinding="{Binding Details}"
                                    Header="Details" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#64748B" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddButton"
                        Width="84"
                        Margin="0,0,8,0"
                        Click="AddButton_Click"
                        Content="Add"
                        IsEnabled="False" />
                <Button Width="84"
                        Click="CancelButton_Click"
                        Content="Cancel" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
