<Window x:Class="Surf2.RelationalSnapshotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database History"
        Width="1120"
        Height="620"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HistoryButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="#1E3A8A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding"
                    Value="8,2" />
            <Setter Property="MinHeight"
                    Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="Opacity"
                                        Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryCountTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
        </Style>
        <Style x:Key="HistoryAddedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryCountTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAddedLines}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.SuccessTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryRemovedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryCountTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRemovedLines}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#F8FAFC">
            <TextBlock x:Name="HeaderTextBlock"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="12,8"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Background="#F8FAFC">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        MinWidth="82"
                        Click="CloseButton_Click"
                        Content="Close"
                        Style="{StaticResource HistoryButtonStyle}" />
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#64748B" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="#1F2937"
                           Text="Find:" />
                <TextBox x:Name="HistoryFilterTextBox"
                         Height="28"
                         MinWidth="260"
                         VerticalContentAlignment="Center"
                         TextChanged="HistoryFilterTextBox_TextChanged" />
            </DockPanel>
        </Border>

        <ListView x:Name="RowsListView"
                  ContextMenuOpening="RowsListView_ContextMenuOpening"
                  MouseDoubleClick="RowsListView_MouseDoubleClick"
                  PreviewMouseRightButtonDown="RowsListView_PreviewMouseRightButtonDown"
                  BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVersion}"
                                     Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource Theme.PanelBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceAltBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding IndentMargin}"
                                            Orientation="Horizontal">
                                    <Button Width="30"
                                            Height="26"
                                            Margin="0,0,6,0"
                                            Padding="0"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="13"
                                            Click="ToggleRowButton_Click"
                                            Content="{Binding ToggleGlyph}"
                                            Style="{StaticResource HistoryButtonStyle}"
                                            ToolTip="{Binding ToggleToolTip}"
                                            Visibility="{Binding ToggleVisibility}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding VersionColumn}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="150"
                                    DisplayMemberBinding="{Binding ResourceTypeColumn}" />
                    <GridViewColumn Width="380"
                                    DisplayMemberBinding="{Binding NameColumn}" />
                    <GridViewColumn Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddedColumn}" Style="{StaticResource HistoryAddedTextStyle}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemovedColumn}" Style="{StaticResource HistoryRemovedTextStyle}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
